[Unit]
Description=Suppression Manager
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/suppression-manager
ExecStart=/opt/suppression-manager/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3
Environment="PATH=/opt/suppression-manager/venv/bin"
EnvironmentFile=/opt/suppression-manager/.env

[Install]
WantedBy=multi-user.target
